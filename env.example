# Ozon Seller настройки
# URL для старта - может содержать токен для быстрого доступа
# Вариант 1: С токеном (рекомендуется, если токен актуален)
# OZON_START_URL=https://seller.ozon.ru/app/products?token=YOUR_TOKEN_HERE
# Вариант 2: Без токена (потребуется полная авторизация)
OZON_START_URL=https://seller.ozon.ru/app/products
# Номер телефона для входа в Ozon Seller (обязательно!)
PHONE_NUMBER=+79991234567

# Задержки для имитации человеческого поведения (в секундах)
DELAY_BEFORE_CLICK=1.5
DELAY_AFTER_CLICK=2.0
DELAY_BEFORE_TYPE=0.8
DELAY_AFTER_TYPE=1.2
DELAY_BETWEEN_KEYS=0.1
DELAY_PAGE_LOAD=3.0

# Пути
DOWNLOADS_DIR=downloads
LOGS_DIR=logs

# Браузер
HEADLESS=false
BROWSER_TYPE=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Профиль Chrome для сохранения авторизации (опционально)
# Если не указано, путь определяется автоматически для вашей ОС
# 
# Универсальные пути (рекомендуется):
# Windows: %LOCALAPPDATA%\Google\Chrome\User Data
# Linux: ~/.config/google-chrome
# macOS: ~/Library/Application Support/Google/Chrome
# 
# Или укажите полный путь:
# Windows: C:\Users\ВашеИмя\AppData\Local\Google\Chrome\User Data
# 
# Чтобы найти имя профиля:
# 1. Откройте Chrome с нужным профилем
# 2. Введите в адресной строке: chrome://version/
# 3. Найдите "Путь к профилю" - там будет указано Profile 1, Profile 2 и т.д.
# 
# ВАЖНО: Указывайте путь ТОЛЬКО до папки "User Data", без имени профиля!
# 
# CHROME_USER_DATA_DIR=%LOCALAPPDATA%\Google\Chrome\User Data
# CHROME_PROFILE_NAME=Profile 1

# Google Sheets интеграция
# UPLOAD_TO_GOOGLE_SHEETS=true
# GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/1mIfn4doidmfVOBa4ZBeijq533Z2I4Ax-B8K-t5avCMw/edit
# GOOGLE_SHEETS_CREDENTIALS_PATH=google_sheets_credentials.json
# GOOGLE_SHEETS_SPREADSHEET_ID=1mIfn4doidmfVOBa4ZBeijq533Z2I4Ax-B8K-t5avCMw

# Telegram бот
# Получите токен у @BotFather в Telegram:
# 1. Найдите @BotFather в Telegram
# 2. Отправьте /newbot
# 3. Следуйте инструкциям
# 4. Скопируйте полученный токен
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Пароль для доступа к боту (придумайте свой)
TELEGRAM_BOT_PASSWORD=your_password_here




